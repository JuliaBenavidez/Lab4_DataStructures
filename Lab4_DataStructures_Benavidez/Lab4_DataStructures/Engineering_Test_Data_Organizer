# IX. APPENDIX
# EXERCISE 1: ENGINEERING TEST DATA ORGANIZER

from collections import Counter, defaultdict

# Student-specific inputs
LAST_NAME = "Benavidez"
STUDENT_ID = "TUPM-26-1835"
SEED_NUM = int(STUDENT_ID[-1])
FAVORITE_ARTIST = "DILAW"

artist_values = [ord(c) % 10 for c in FAVORITE_ARTIST if c.isalpha()]

# 1. Generate Test Data
sources = [f"{LAST_NAME}_T{i}" for i in range(1, 6)]
categories = ["TEMPERATURE", "VOLTAGE", "CURRENT",
              "PRESSURE", "SPEED"]

records = []

for i in range(5):
    value = SEED_NUM * 10 + artist_values[i] + i
    records.append({
        "source": sources[i],
        "category": categories[i],
        "value": value
    })

# Additional measurements in two categories
records.append({
    "source": sources[0],
    "category": "TEMPERATURE",
    "value": SEED_NUM * 10 + artist_values[1]
})

records.append({
    "source": sources[1],
    "category": "VOLTAGE",
    "value": SEED_NUM * 5 + artist_values[2]
})

# One repeated record
records.append(records[0].copy())

# 2. Organize Data
records.sort(key=lambda r: (r["category"], r["source"], r["value"]))

print("\n=== 1. GENERATED TEST DATA ===")
for r in records:
    print(r)

print("\n=== 2. ORGANIZED TEST DATA ===")
for category in categories:
    group = [r for r in records if r["category"] == category]
    if group:
        print(f"{category}:")
        for r in group:
            print(f"  {r['source']} = {r['value']}")

# 3. Repeated and Distinct Data
counts = Counter(
    (r["source"], r["category"], r["value"]) for r in records
)

print("\n=== 3. REPEATED / DISTINCT DATA ===")
print("Repeated Records:")
for record, count in counts.items():
    if count > 1:
        print(record, "appears", count, "times")

print("Distinct Sources:", sorted(set(r["source"] for r in records)))
print("Distinct Categories:", sorted(set(r["category"] for r in records)))

# 4. Numerical and Categorical Summaries
print("\n=== 4. NUMERICAL AND CATEGORICAL SUMMARIES ===")
category_data = defaultdict(list)

for r in records:
    category_data[r["category"]].append(r["value"])

for category, values in sorted(category_data.items()):
    print(f"{category}: Count={len(values)}, "
          f"Average={sum(values) / len(values):.2f}, "
          f"Minimum={min(values)}, Maximum={max(values)}")

# 5. Processed Results
print("\n=== 5. PROCESSED RESULTS ===")
print("Total measurements:", len(records))
print("Unique record types:", len(counts))
print("Repeated record types:", sum(n > 1 for n in counts.values()))

# 6. Ordered Results
print("\n=== 6. ORDERED RESULTS ===")
for r in records:
    print(f"{r['category']} | {r['source']} | {r['value']}")

# 7. Final Summary
values = [r["value"] for r in records]

print("\n=== 7. FINAL SUMMARY ===")
print("Total measurements:", len(records))
print("Distinct sources:", len(set(r["source"] for r in records)))
print("Distinct categories:", len(set(r["category"] for r in records)))
print("Overall average:", round(sum(values) / len(values), 2))

